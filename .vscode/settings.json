            "approve": true,
            "matchCommandLine": true
        },
        "/^which python3 && python3 -m pytest tests/unit/connectors/test_fk_detection\\.py -v 2>&1 \\| tail -40$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
