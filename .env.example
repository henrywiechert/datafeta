# Example environment file for the all-in-one Docker Compose deployment.
# Copy this file and adjust the values, e.g.:
#   cp .env.example .env
# then run:
#   docker compose --env-file .env up
#
# You can keep several flavours side by side by using suffixed files
# (.env.staging, .env.prod, ...) together with a matching image tag built
# via ./build-docker.sh <suffix>. In that case APP_VERSION must equal <suffix>.
#
# Frontend (Create React App) build-time variables are documented separately
# in frontend/.env.production.example.

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=data-slicer
APP_VERSION=latest          # must match the image tag built by ./build-docker.sh <suffix>
CONTAINER_NAME=data-slicer
HOST_PORT=8080
SNAPSHOT_DIR=./data/snapshots

# --- Backend runtime (optional overrides of the compose defaults) ---
LOG_LEVEL=INFO
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
HF_MAX_SPLIT_BYTES_MB=500
SNAPSHOT_STORAGE_DIR=/app/data/snapshots
UPLOAD_ROOT_DIR=
LOG_FILE=

# --- Query optimizer (optional) ---
# OPTIMIZER_ENABLE_DISTINCT_PAIRS=true
# OPTIMIZER_ENABLE_ADAPTIVE_ROUNDING=true
# OPTIMIZER_ROUNDING_THRESHOLD=10000
# OPTIMIZER_TARGET_BUCKETS=100
# OPTIMIZER_ESTIMATION_TIMEOUT_MS=500
# OPTIMIZER_ENABLE_SMALL_TABLE_DETECTION=true
# OPTIMIZER_SMALL_TABLE_THRESHOLD=5000
# OPTIMIZER_ENABLE_COUNT_CACHE=true
# OPTIMIZER_COUNT_CACHE_TTL_SECONDS=300
# OPTIMIZER_COUNT_CACHE_MAX_SIZE=256
