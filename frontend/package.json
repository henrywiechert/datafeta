{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@observablehq/plot": "^0.6.17",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.9.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^2.0.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "apache-arrow": "^21.2.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "react-window": "^2.3.1",
    "typescript": "^4.9.5",
    "uuid": "^14.0.2",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "prestart": "node scripts/generate-version.js && node scripts/generate-tokens.js",
    "start": "react-scripts start",
    "prebuild": "node scripts/generate-version.js && node scripts/generate-tokens.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "check:cycles": "npx --yes madge@7 --circular --extensions ts,tsx src",
    "generate:tokens": "node scripts/generate-tokens.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
          "message": "Hardcoded color. Use a token from src/theme/tokens.ts (T.*) or an MUI palette key in sx. See src/theme/THEMING.md."
        },
        {
          "selector": "Literal[value=/\\b(rgb|rgba|hsl|hsla)\\s*\\(/]",
          "message": "Hardcoded color. Use a token from src/theme/tokens.ts (T.*) or an MUI palette key in sx. See src/theme/THEMING.md."
        },
        {
          "selector": "TemplateElement[value.raw=/#[0-9a-fA-F]{3,8}\\b/]",
          "message": "Hardcoded color in a template literal. Interpolate a token from src/theme/tokens.ts instead. See src/theme/THEMING.md."
        },
        {
          "selector": "TemplateElement[value.raw=/\\b(rgb|rgba|hsl|hsla)\\s*\\(/]",
          "message": "Hardcoded color in a template literal. Interpolate a token from src/theme/tokens.ts instead. See src/theme/THEMING.md."
        },
        {
          "selector": "Literal[value=/^(white|black|gray|grey)$/i]",
          "message": "Named color. Use a token from src/theme/tokens.ts (T.*) or 'currentColor'. Named colors hide from hex searches and do not follow the theme. See src/theme/THEMING.md."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "**/*.test.ts",
          "**/*.test.tsx"
        ],
        "rules": {
          "testing-library/no-container": "off",
          "testing-library/no-node-access": "off",
          "testing-library/prefer-screen-queries": "off",
          "testing-library/render-result-naming-convention": "off",
          "jest/no-conditional-expect": "off",
          "no-restricted-syntax": "off"
        }
      },
      {
        "files": [
          "src/components/icons/DataSlicerIcon.tsx",
          "src/config/colorSchemes.ts",
          "src/theme/**"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8010",
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    }
  }
}
